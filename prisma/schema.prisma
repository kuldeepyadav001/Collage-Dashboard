
// ─── ENUMS ────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  WRITE_ADMIN
  READER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── USERS (Faculty / Trainers / Admins) ──────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(READER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ACADEMIC STRUCTURE ───────────────────────────────

model Year {
  id        String   @id @default(cuid())
  label     String   @unique  // "2024", "2025"
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id        String    @id @default(cuid())
  name      String                        // "BTech", "BCA"
  yearId    String
  year      Year      @relation(fields: [yearId], references: [id], onDelete: Cascade)
  sections  Section[]
  createdAt DateTime  @default(now())

  @@unique([name, yearId])
}

model Section {
  id        String    @id @default(cuid())
  name      String                        // "A", "B", "C"
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students  Student[]
  tests     Test[]
  createdAt DateTime  @default(now())

  @@unique([name, courseId])
}

// ─── STUDENTS ─────────────────────────────────────────

model Student {
  id          String   @id @default(cuid())
  name        String
  rollNumber  String   @unique
  email       String   @unique
  phone       String?
  address     String?
  photoUrl    String?
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  eliteMemberships EliteSectionMember[]
  testMarks        TestMark[]
}

// ─── ELITE SECTIONS ───────────────────────────────────

model EliteSection {
  id          String   @id @default(cuid())
  name        String   @unique               // "Service Based", "Production Based"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     EliteSectionMember[]
  tests       Test[]
  attendance  AttendanceSession[]
}

model EliteSectionMember {
  id             String       @id @default(cuid())
  studentId      String
  eliteSectionId String
  joinedAt       DateTime     @default(now())

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eliteSection   EliteSection @relation(fields: [eliteSectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, eliteSectionId])   // no duplicate membership
}

// ─── TESTS ────────────────────────────────────────────

model Test {
  id             String        @id @default(cuid())
  name           String
  date           DateTime
  maxMarks       Float
  // belongs to either a regular section OR an elite section
  sectionId      String?
  eliteSectionId String?

  section        Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  eliteSection   EliteSection? @relation(fields: [eliteSectionId], references: [id], onDelete: Cascade)
  marks          TestMark[]
  createdAt      DateTime      @default(now())
}

model TestMark {
  id        String   @id @default(cuid())
  testId    String
  studentId String
  marks     Float
  absent    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])           // one mark per student per test
}

// ─── ATTENDANCE (elite sections only) ─────────────────

model AttendanceSession {
  id             String             @id @default(cuid())
  eliteSectionId String
  date           DateTime
  topic          String?
  createdAt      DateTime           @default(now())

  eliteSection   EliteSection       @relation(fields: [eliteSectionId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]

  @@unique([eliteSectionId, date])        // one session per section per day
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus  @default(PRESENT)

  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
}